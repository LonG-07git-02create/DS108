# ============================================================
# BDS Crawler — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Crawler settings ─────────────────────────────────────────
# Base URL of the listing page to scrape
BASE_URL=https://batdongsan.com.vn/ban-nha-dat-tp-hcm

# Query string appended to every page URL
QUERY_STRING=?vrs=1

# Total number of listing URLs to collect
TARGET_SAMPLES=3500

# Seconds to wait between page navigations (politeness delay)
PAGE_DELAY=2

# Seconds to wait between detail-page requests
DETAIL_DELAY=0.1

# Maximum seconds to wait for Cloudflare challenge to pass
CLOUDFLARE_TIMEOUT=30

# Maximum seconds to wait for a page element to appear
ELEMENT_TIMEOUT=15

# ── Output paths ──────────────────────────────────────────────
# File that stores collected listing URLs (one per line)
HREFS_FILE=hrefs.txt

# CSV file that stores scraped property details
CSV_FILE=data_bds.csv

# ── Chrome / undetected-chromedriver ─────────────────────────
# Window size for the browser instance
WINDOW_SIZE=1920,1080

# User-Agent string sent to the target site
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
